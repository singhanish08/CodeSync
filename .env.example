# ─────────────────────────────────────────────────────────────
# CodeSync root .env.example
#
# This monorepo has TWO apps, each with its own env file:
#   server/.env  → copy from server/.env.example
#   client/.env  → copy from client/.env.example
#
# A single combined reference is below for convenience. Do NOT
# use this root file directly — the apps read their own files.
# ─────────────────────────────────────────────────────────────

# ════════════ SERVER (server/.env) ════════════
PORT=5175
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GROQ_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
FRONTEND_URL=http://localhost:5176
NODE_ENV=development

# ════════════ CLIENT (client/.env) ════════════
VITE_API_URL=http://localhost:5175
VITE_SOCKET_URL=http://localhost:5175
